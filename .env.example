# These are set in the Netlify UI, NOT in a file in the repo.
# Site configuration → Environment variables. See SETUP.md step 4.
#
# This file documents the names only. Never commit real values.

# Fine-grained personal access token, scoped to this repo, Contents: read and write.
GITHUB_TOKEN=

# owner/repo — e.g. clark/vhs-sleeve. No https://, no .git suffix.
GITHUB_REPO=

# Optional, defaults to main.
GITHUB_BRANCH=main
