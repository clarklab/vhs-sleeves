# Set in the Netlify UI, NOT in a file in the repo.
# Site configuration → Environment variables. See SETUP.md.
#
# This file documents the names only. Never commit real values.

# Fine-grained personal access token, scoped to clarklab/vhs-sleeves,
# Contents: read and write. This is the only variable uploads require.
GITHUB_TOKEN=

# Optional. The repo is hardcoded to clarklab/vhs-sleeves in
# netlify/functions/submit-sleeve.mts; set this only to point at a different one.
GITHUB_REPO=

# Optional, defaults to main.
GITHUB_BRANCH=main
